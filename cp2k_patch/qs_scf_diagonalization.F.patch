+   SUBROUTINE research_overlap_dump(matrix, ikp, n)
+      TYPE(cp_cfm_type), INTENT(IN) :: matrix
+      INTEGER, INTENT(IN) :: ikp,n
+      COMPLEX(KIND=dp), ALLOCATABLE :: block(:,:)
+      CHARACTER(LEN=100) :: fname
+      INTEGER :: unit,i,part
+      LOGICAL :: exists
+      WRITE(fname,'("research_S_k",I3.3,"_p1.dat")') ikp
+      INQUIRE(FILE=TRIM(fname),EXIST=exists)
+      ! All ranks check shared file; synchronization avoids a partial-file race.
+      CALL matrix%matrix_struct%para_env%bcast(exists)
+      IF (exists) RETURN
+      ALLOCATE(block(n,n))
+      CALL cp_cfm_get_submatrix(matrix,block)
+      IF (matrix%matrix_struct%para_env%is_source()) THEN
+         DO part=1,2
+            WRITE(fname,'("research_S_k",I3.3,"_p",I1,".dat")') ikp,part
+            OPEN(NEWUNIT=unit,FILE=TRIM(fname),STATUS='REPLACE',ACTION='WRITE')
+            WRITE(unit,*) n
+            DO i=1,n
+               IF (part==1) THEN
+                  WRITE(unit,'(*(ES25.16E3,1X))') REAL(block(i,:),dp)
+               ELSE
+                  WRITE(unit,'(*(ES25.16E3,1X))') AIMAG(block(i,:))
+               END IF
+            END DO
+            CLOSE(unit)
+         END DO
+      END IF
+      CALL matrix%matrix_struct%para_env%sync()
+      DEALLOCATE(block)
+   END SUBROUTINE
+
+
