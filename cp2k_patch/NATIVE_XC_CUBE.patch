+      ! Evaluate with CP2K's own density, XC settings and native XC kernel.
+      ! qs_xc_density calls the same xc_vxc_pw_create1 as qs_vxc_create,
+      ! but avoids changing the SCF energy/virial and exports the final density.
+      IF (BTEST(cp_print_key_should_output(logger%iter_info, input, &
+                                           "DFT%PRINT%NATIVE_XC_CUBE"), cp_p_file)) THEN
+         BLOCK
+            TYPE(pw_r3d_rs_type), ALLOCATABLE :: native_vxc(:)
+            LOGICAL :: native_tau_valid, native_hfx
+            TYPE(section_vals_type), POINTER :: native_hfx_section
+
+            IF (dft_control%qs_control%gapw .OR. dft_control%qs_control%gapw_xc .OR. &
+                dft_control%do_admm .OR. dft_control%apply_external_density .OR. &
+                dft_control%apply_external_vxc) THEN
+               CPABORT("NATIVE_XC_CUBE supports ordinary GPW LDA/GGA only")
+            END IF
+            CALL qs_rho_get(rho, tau_r_valid=native_tau_valid)
+            native_hfx_section => section_vals_get_subs_vals(input, "DFT%XC%HF")
+            CALL section_vals_get(native_hfx_section, explicit=native_hfx)
+            IF (native_tau_valid .OR. native_hfx) THEN
+               CPABORT("NATIVE_XC_CUBE does not export meta-GGA or nonlocal exchange operators")
+            END IF
+            CALL get_qs_env(qs_env, pw_env=pw_env)
+            CALL pw_env_get(pw_env, auxbas_pw_pool=auxbas_pw_pool)
+            ALLOCATE (native_vxc(dft_control%nspins))
+            DO ispin = 1, dft_control%nspins
+               CALL auxbas_pw_pool%create_pw(native_vxc(ispin))
+            END DO
+            xc_section => section_vals_get_subs_vals(input, "DFT%XC")
+            CALL qs_xc_density(ks_env=qs_env%ks_env, rho_struct=rho, xc_section=xc_section, &
+                               dispersion_env=qs_env%dispersion_env, vxc=native_vxc)
+            append_cube = section_get_lval(input, "DFT%PRINT%NATIVE_XC_CUBE%APPEND")
+            my_pos_cube = "REWIND"
+            IF (append_cube) my_pos_cube = "APPEND"
+            mpi_io = .TRUE.
+            DO ispin = 1, dft_control%nspins
+               filename = "v_xc"
+               IF (dft_control%nspins == 2) THEN
+                  IF (ispin == 1) filename = "v_xc_alpha"
+                  IF (ispin == 2) filename = "v_xc_beta"
+               END IF
+               unit_nr = cp_print_key_unit_nr(logger, input, "DFT%PRINT%NATIVE_XC_CUBE", &
+                                              extension=".cube", middle_name=TRIM(filename), &
+                                              file_position=my_pos_cube, mpi_io=mpi_io)
+               ! The native XC array is already in Hartree; unlike stored
+               ! v_hartree_rspace it has NOT been multiplied by pw_grid%dvol.
+               CALL cp_pw_to_cube(native_vxc(ispin), unit_nr, "NATIVE LOCAL XC POTENTIAL [hartree]", &
+                                  particles=particles, &
+                                  stride=section_get_ivals(input, "DFT%PRINT%NATIVE_XC_CUBE%STRIDE"), &
+                                  mpi_io=mpi_io)
+               CALL cp_print_key_finished_output(unit_nr, logger, input, &
+                                                 "DFT%PRINT%NATIVE_XC_CUBE", mpi_io=mpi_io)
+               CALL auxbas_pw_pool%give_back_pw(native_vxc(ispin))
+            END DO
+            DEALLOCATE (native_vxc)
+            IF (output_unit > 0) WRITE (output_unit, '(A)') &
+               " NATIVE_XC| Final-density local XC exported in Hartree using the native CP2K kernel."
+         END BLOCK
+      END IF
